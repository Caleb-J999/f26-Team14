<#import "layout.ftlh" as layout>

<@layout.page title="Home">
    <section class="hero">
        <h2>Find Your Creative Space</h2>
        <p>
            Discover studios, rehearsal rooms, and maker spaces
            for your next creative project.
        </p>
    </section>

    <section class="card">
        <h2>Welcome to StudioShare</h2>
        <p>Create a customer account or browse creative spaces.</p>

        <a class="button" href="/signup">Create an Account</a>
        <a class="button" href="/spaces">Browse Spaces</a>
    </section>
</@layout.page>